{
  "name": "brain-tumor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "python -m uvicorn backend.main:app --host 127.0.0.1 --port 8000",
    "dev:full": "concurrently --kill-others-on-fail \"npm:dev\" \"npm:dev:api\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test:api": "python -m unittest discover -s tests",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.6",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
